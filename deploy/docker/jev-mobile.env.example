# Copy outside this repository, then set JEV_MOBILE_ENV_FILE to its absolute path.
# Credentials are intentionally not committed and are never baked into the image.
MOBILE_DEVICE_SERIAL=replace-with-adb-serial
TYPESAFE_API_KEY=replace-with-secret

