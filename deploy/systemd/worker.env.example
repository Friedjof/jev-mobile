JEV_MOBILE_BACKEND=portal-adb
JEV_MOBILE_DEVICE=replace-with-adb-serial
JEV_MOBILE_DB=/home/replace-me/.local/share/jev-mobile/tasks.sqlite3
# Keep the key value out of the service environment and systemctl diagnostics.
TYPESAFE_API_KEY_FILE=/home/replace-me/.config/jev-mobile/secrets/typesafe_api_key
# Optional explicit ADB locations. When set, worker readiness validates them
# before claiming any task.
ANDROID_USER_HOME=/home/replace-me/.android
ADB_VENDOR_KEYS=/home/replace-me/.android/adbkey
