MOBILE_MCP_COMMAND_JSON=["npx","-y","@mobilenext/mobile-mcp@1.0.4"]
MOBILE_DEVICE_SERIAL=
MAX_JEV_STEPS_WITHOUT_PROGRESS=20
MAX_SAFE_EXPLORATION_BRANCHES=5
MAX_GROUP_REVISITS=2
# Optional: uses the custom USB-forwarded Accessibility Bridge instead of Mobile MCP.
JEV_MOBILE_BRIDGE_PORT=8765
# Needed only for a non-debug bridge APK. Never commit this value.
JEV_MOBILE_BRIDGE_TOKEN=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
ENABLE_LLM_PLANNING=false
MAX_PLAN_RECOVERIES=1
TRACE_DIR=traces
MINIMUM_STABLE_TIME_SECONDS=0.25
STABILIZER_TIMEOUT_SECONDS=5.0
DECISION_CONFIDENCE_THRESHOLD=0.80
SINGLE_SAFE_ACTION_CONFIDENCE_THRESHOLD=0.70
MINIMUM_PROBABILITY_MARGIN=0.15
ACTION_PAGE_SIZE=10
MAX_ACTION_PAGES=3
CAPTURE_ESCALATION_SCREENSHOTS=true
TYPESAFE_API_KEY=
# Optional additional operating rules. The built-in safe controller policy is always retained.
MOBILE_AGENT_SYSTEM_PROMPT=
